{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SpotiDesk",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 20
        },
        "resizable": true,
        "shadow": true,
        "backgroundColor": "#000000",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ]
  }
}
